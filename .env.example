# ─── HCP Boundary ─────────────────────────────────────────────────────────────
# Cluster: <your-cluster-name> — from portal.cloud.hashicorp.com
BOUNDARY_ADDR=https://<cluster-id>.boundary.hashicorp.cloud

# HCP Boundary admin credentials (set when you created the cluster)
BOUNDARY_ADMIN_LOGIN_NAME=admin
BOUNDARY_ADMIN_PASSWORD=<your-admin-password>

# HCP Boundary credential used by the agent (created by boundary/setup.sh)
BOUNDARY_AUTH_METHOD_ID=ampw_XXXXXXXXXX
BOUNDARY_LOGIN_NAME=demo-agent
BOUNDARY_PASSWORD=change-me-before-demo

# Target IDs (populated automatically by boundary/setup.sh)
BOUNDARY_SSH_TARGET_ID=
BOUNDARY_DB_TARGET_ID=

# Cluster ID = the UUID in BOUNDARY_ADDR (also the UUID in the HCP portal's
# cluster URL — it isn't shown as a separate field anywhere) — used in boundary/worker.hcl
HCP_BOUNDARY_CLUSTER_ID=<cluster-id>

# ─── Vault (local Docker dev) ─────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_DEV_TOKEN=root

# AppRole credentials for the AI agent (created by vault/setup.sh)
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres

# ─── Agent behaviour ──────────────────────────────────────────────────────────
# The agent runs on the `claude` CLI in headless mode (subscription auth via
# `claude /login` — no ANTHROPIC_API_KEY needed). AGENT_MODEL accepts the
# short aliases the CLI understands: sonnet | opus | haiku
AGENT_MODEL=sonnet
